{
  // Shared identifiers — used by simulate, train, serve, and benchmark.
  "mapConfig": "mini",
  "gameConfig": "mini_2p",
  "modelConfig": "small",
  // Model type: "state", "placement", or "combined" (placement then state).
  // Placement uses the state-only placement_state_v3 architecture.
  "modelType": "placement",

  // Omit "seed" for non-reproducible runs, or set for reproducibility.
  // Each generation offsets the seed: seed + gen for simulate, seed + gen*1000 for benchmark.
  "seed": 42,

  // Directories for pipeline artifacts (relative to project root).
  "dataDir": "pipeline/data",
  "modelDir": "pipeline/models",
  "resultsDir": "pipeline/results",

  // Number of generations to run (gen 0 .. generations-1).
  "generations": 10,

  // Self-play simulation parameters (gimbur simulate).
  "simulate": {
    "games": 1000,
    "players": 2,
    "searchTimeMs": 500,
    "maxSimulations": 200,
    "maxRolloutDepth": 500,
    // "actionRolloutLimit": 50,  // uncomment to cap per-action rollouts
    "symmetries": true,
    "verbosity": "quiet",
    // Request oversample*games from the CLI and stop early once "games"
    // files have been written.  Avoids waiting for long-tail slow games.
    // 1.0 = no oversampling (default), 1.1 = request 10% extra.
    "oversample": 1.1,
    // Per-game evaluation quality gates. Hard errors are timeout + invalid + orphan.
    "maxErrorsPerGame": 5,
    "maxErrorRatePerGame": 0.02,
    "minimumRequestsForRate": 50,
    "discardGamesWithFallbacks": false,
    // Stop generation rather than retrying forever when inference is unhealthy.
    "maxDiscardedGames": 20,
    "maxDiscardRate": 0.05,
    "minimumAttemptsForDiscardRate": 50,
    "maxConsecutiveDiscards": 5
  },

  // Model training parameters (python -m gimbur_nn.train).
  "train": {
    "epochs": 0,
    "patience": 5,
    "batchSize": 64,
    "lr": 1e-4,
    "valSplit": 0.1,
    "testSplit": 0.0,
    "logInterval": 50,
    // Placement models support "value" or "combined". Combined emits value
    // [B,N] per-player value and dense policy [B,A] logits.
    "outputMode": "combined",
    "target": "combined",
    // Blend normalized MCTS wins with the final game's one-hot winner.
    // Invalid/missing evidence falls back to the other target; 0.5 is equal weight.
    "mctsValueWeight": 0.5,
    // Full-state pipelines keep all states through this turn, then sample a
    // deterministic per-game late-state cap. Placement datasets are not sampled.
    "earlyGameTurnLimit": 10,
    "maxLateGameStatesPerGame": 20,
    "valueLossWeight": 1.0,
    "policyLossWeight": 1.0,
    // Enable per-epoch checkpointing for training recovery.
    "checkpointDir": true,
    // When true, each generation resumes training from the previous
    // generation's model weights instead of starting from scratch.
    "resumeFromPrevious": true
  },

  // Inference server parameters (python -m gimbur_nn.serve).
  "serve": {
    "port": 8000,
    "host": "127.0.0.1",
    // Log level for uvicorn. Use "warning" to suppress HTTP 200/202 access
    // logs while still showing errors. Options: debug, info, warning, error.
    "logLevel": "warning"
  },

  // Benchmark configurations. Each entry runs independently after training.
  "benchmarks": [
    {
      "name": "nn-vs-greedy",
      "games": 100,
      "ai": ["nn", "greedy"]
    },
    {
      "name": "nn-vs-random",
      "games": 100,
      "ai": ["nn", "random"]
    }
  ]
}
