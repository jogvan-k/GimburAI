{
  // Current-only complete full-state policy/value pipeline.
  "mapConfig": "mini",
  "gameConfig": "mini_2p",
  "modelConfig": "small",
  "seed": 42,
  "dataDir": "pipeline/data",
  "modelDir": "pipeline/models",
  "resultsDir": "pipeline/results",
  "generations": 10,
  "inference": {
    "exportFp16": false,
    "simulationPrecision": "fp32",
    "benchmarkPrecisions": ["fp32"],
    "promotionPrecision": "fp32"
  },
  "gen0Milestones": [200, 400, 600, 800, 1000],
  "simulate": {
    "games": 1000,
    "players": 2,
    "searchTimeMs": 500,
    "maxSimulations": 200,
    "maxRolloutDepth": 500,
    "greedyPrior": true,
    "greedyPriorUniformMix": 0.25,
    "symmetries": true,
    "verbosity": "quiet",
    "oversample": 1.1,
    "maxErrorsPerGame": 5,
    "maxErrorRatePerGame": 0.02,
    "minimumRequestsForRate": 50,
    "discardGamesWithFallbacks": false,
    "maxDiscardedGames": 20,
    "maxDiscardRate": 0.05,
    "minimumAttemptsForDiscardRate": 50,
    "maxConsecutiveDiscards": 5
  },
  "train": {
    "epochs": 0,
    "patience": 5,
    "batchSize": 64,
    "lr": 1e-4,
    "valSplit": 0.1,
    "testSplit": 0.0,
    "logInterval": 50,
    "mctsValueWeightStart": 0.9,
    "mctsValueWeightEnd": 0.1,
    "victoryPointSamplingStatistic": "median",
    "victoryPointSamplingUpperPercentage": 0.10,
    "valueLossWeight": 1.0,
    "policyLossWeight": 1.0,
    "checkpointDir": true,
    "resumeFromPrevious": true,
    "replayGenerations": 3
  },
  "serve": {
    "port": 8000,
    "host": "127.0.0.1",
    "logLevel": "warning"
  },
  "promotion": {
    "enabled": true,
    "additionalTrainingGames": 500,
    "maxRetries": 2,
    "direct": {
      "games": 10000,
      "ai": "nn",
      "minimumImprovementVsGreedy": 0.0,
      "minimumImprovementVsChampion": 0.0
    },
    "hybrid": {
      "games": 1000,
      "ai": "server-mcts-nn",
      "searchTimeMs": 1000,
      "minimumImprovementVsGreedy": 0.0,
      "minimumImprovementVsChampion": 0.0
    }
  },
  "benchmarks": [
    {
      "name": "complete-vs-greedy",
      "games": 10000,
      "ai": ["nn", "greedy"]
    },
    {
      "name": "complete-mcts-vs-greedy",
      "games": 1000,
      "ai": ["server-mcts-nn", "greedy"],
      "searchTimeMs": 1000
    }
  ]
}
